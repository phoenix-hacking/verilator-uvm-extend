"""Run the actual compiler debug registry with ThreadSanitizer.

Build Verilator first, then run:
  nodist/test_global_debug --output /tmp/verilator-debug-test

The output directory must be new. Generated AST headers must match the source.
Compilation, execution, and independently verified JSON outputs are retained.
"""

import argparse
import json
import os
from pathlib import Path
import shlex
import subprocess
import sys


def unique_object(pairs):
    """Reject duplicate JSON keys instead of silently overwriting them."""
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f'Duplicate JSON key: {key}')
        result[key] = value
    return result


def verify(filename):
    """Check the complete bijection, sequential ID range, and field-name set."""
    data = json.loads(filename.read_text(), object_pairs_hook=unique_object)
    assert len(data['expected']) == 2048
    assert len(set(data['expected'].values())) == 2048
    expected = dict(data['expected'])
    expected['0'] = '0'
    assert data['pointers'] == expected
    identifiers = set()
    for value in range(2, 2050):
        letters = ''
        while value:
            letters += chr(ord('A') + value % 26)
            value //= 26
        identifiers.add('(' + letters + ')')
    assert set(data['expected']) == identifiers
    assert sorted(data['ptrFieldNames']) == sorted('field' + str(i) for i in range(16))


def main():
    """Compile actual registry functions and check concurrent readers/writers."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--root', type=Path, default=Path(__file__).resolve().parent.parent)
    parser.add_argument('--generated-headers', type=Path)
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--cxx', default=os.environ.get('CXX', 'c++'))
    args = parser.parse_args()
    root = args.root.resolve()
    generated = (args.generated_headers or root / 'src/obj_dbg').resolve()
    if not (generated / 'V3Ast__gen_forward_class_decls.h').is_file():
        parser.error('Build Verilator first: generated AST headers are required')
    output = args.output.resolve()
    output.mkdir(parents=True, exist_ok=False)
    flags = [
        *shlex.split(args.cxx), '-std=c++17', '-O1', '-g', '-fsanitize=thread',
        '-ffunction-sections', '-fdata-sections', '-pthread', '-I' + str(root / 'src'),
        '-I' + str(root / 'include'), '-I' + str(generated),
        *shlex.split(os.environ.get('CPPFLAGS', ''))
    ]
    commands = [
        ('compile',
         [*flags, '-c',
          str(root / 'src/V3Global.cpp'), '-o',
          str(output / 'registry.o')]),
        ('link', [
            *flags,
            str(Path(__file__).with_suffix('.cpp').resolve()),
            str(output / 'registry.o'), '-Wl,--gc-sections', '-o',
            str(output / 'test_global_debug')
        ]),
        ('run', [str(output / 'test_global_debug')]),
    ]
    environment = dict(os.environ, TSAN_OPTIONS='halt_on_error=1:exitcode=66')
    results = []
    for label, command in commands:
        with (output /
              (label + '.out')).open('w') as stdout, (output /
                                                      (label + '.err')).open('w') as stderr:
            try:
                code = subprocess.run(command,
                                      cwd=output,
                                      env=environment,
                                      stdout=stdout,
                                      stderr=stderr,
                                      timeout=300,
                                      check=False).returncode
            except subprocess.TimeoutExpired:
                code = 124
        results.append({'label': label, 'command': command, 'exit_code': code})
        (output / 'results.json').write_text(json.dumps(results, indent=2) + '\n')
        if code:
            print(f'{label} failed ({code}); see {output}')
            return 1
    verify(output / 'run.out')
    print('Native debug registry: PASS (2049 IDs, 16 field names, stable references)')
    return 0


if __name__ == '__main__':
    sys.exit(main())
