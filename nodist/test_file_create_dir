"""Run the Linux mkdir-interposition regression against real compiler objects.

Build Verilator first, then run:
  nodist/test_file_create_dir --output /tmp/verilator-file-test

The output directory must be new; commands and outputs are retained on failure.
An individually rebuilt V3File object can replace that unit with --file-object.
Other native objects and headers must come from the same compatible build.
"""

import argparse
import json
import os
from pathlib import Path
import shlex
import subprocess
import sys


def main():
    """Build and run all cases, retaining the commands and results."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--root', type=Path, default=Path(__file__).resolve().parent.parent)
    parser.add_argument('--objects', type=Path)
    parser.add_argument('--file-object', type=Path)
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--cxx', default=os.environ.get('CXX', 'c++'))
    parser.add_argument('--objcopy', default=os.environ.get('OBJCOPY', 'objcopy'))
    args = parser.parse_args()
    if not sys.platform.startswith('linux'):
        parser.error('This native regression requires Linux and a linker with --wrap')
    root = args.root.resolve()
    objects = (args.objects or root / 'src/obj_opt').resolve()
    file_object = (args.file_object or objects / 'V3File.o').resolve()
    for required in (objects / 'Verilator.o', file_object):
        if not required.is_file():
            parser.error(f'Build the native compiler first: missing {required}')
    output = args.output.resolve()
    output.mkdir(parents=True, exist_ok=False)
    commands = []

    def run(label, command, cwd=output):
        commands.append({'label': label, 'command': command, 'cwd': str(cwd)})
        (output / 'commands.json').write_text(json.dumps(commands, indent=2) + '\n')
        with (output / (label + '.log')).open('w') as log:
            result = subprocess.run(command,
                                    cwd=cwd,
                                    stdout=log,
                                    stderr=subprocess.STDOUT,
                                    check=False,
                                    timeout=120)
        if result.returncode:
            print((output / (label + '.log')).read_text(), end='')
        return result.returncode

    renamed = output / 'Verilator-renamed.o'
    if run('rename', [
            *shlex.split(args.objcopy), '--redefine-sym', 'main=verilator_original_main',
            str(objects / 'Verilator.o'),
            str(renamed)
    ]):
        return 1
    if run('compile', [
            *shlex.split(args.cxx), '-std=c++17', '-I' + str(root / 'src'),
            '-I' + str(root / 'include'),
            str(Path(__file__).with_suffix('.cpp').resolve()), '-c', '-o',
            str(output / 'main.o')
    ]):
        return 1
    native_objects = [
        str(path) for path in sorted(objects.glob('*.o'))
        if path.name not in ('Verilator.o', 'V3File.o')
    ]
    executable = output / 'test_file_create_dir'
    if run('link', [
            *shlex.split(args.cxx), *shlex.split(os.environ.get('LDFLAGS', '')),
            '-Wl,--gc-sections', '-Wl,--wrap=mkdir',
            str(renamed),
            str(file_object),
            str(output / 'main.o'), *native_objects, '-pthread', '-latomic', '-lm', '-o',
            str(executable)
    ]):
        return 1
    failed = False
    for case in ('ordinary', 'hierarchical', 'stream', 'stream_hierarchical'):
        workdir = output / case
        workdir.mkdir()
        failed |= bool(run(case, [str(executable), case], workdir))
    print('Native directory creation:', 'FAIL' if failed else 'PASS')
    return int(failed)


if __name__ == '__main__':
    sys.exit(main())
